COMPOSE_PROJECT_NAME=hutch-resolve
POSTGRES_DB=hutch_resolve
POSTGRES_USER=hutch_admin
POSTGRES_PASSWORD=local-only-change-me
POSTGRES_PORT=55432
SANDBOX_DB_USER=hutch_sandbox
SANDBOX_DB_PASSWORD=sandbox-local-change-me
RESOLVE_DB_USER=hutch_resolve_app
RESOLVE_DB_PASSWORD=resolve-local-change-me
DATABASE_URL=postgresql+psycopg://hutch_resolve_app:resolve-local-change-me@127.0.0.1:55432/hutch_resolve
SANDBOX_DATABASE_URL=postgresql+psycopg://hutch_sandbox:sandbox-local-change-me@127.0.0.1:55432/hutch_resolve
MIGRATION_DATABASE_URL=postgresql+psycopg://hutch_admin:local-only-change-me@127.0.0.1:55432/hutch_resolve
APP_ORIGINS=http://localhost:5173
APP_SECRET_KEY=change-me-to-a-random-secret-of-at-least-32-bytes
APP_COOKIE_SECURE=false
DEMO_IDENTITIES_JSON={}
VOICE_BASE_URL=http://localhost:8088
VOICE_HMAC_SECRET=
VOICE_GRANT_ENCRYPTION_KEY=
TRUSTED_PROXY_IPS=
AUTH_GUEST_LIMIT=30
AUTH_LOGIN_IP_LIMIT=30
AUTH_LOGIN_IDENTITY_LIMIT=10
# Review-ticket CRM: mock (default) or hubspot. See docs/plans/hubspot-crm.md.
CRM_PROVIDER=mock
# HubSpot Service Key (secret; never commit). Only needed when CRM_PROVIDER=hubspot.
HUBSPOT_ACCESS_TOKEN=
HUBSPOT_PORTAL_ID=
HUBSPOT_API_BASE=https://api.hubapi.com
HUBSPOT_PIPELINE_ID=
HUBSPOT_STAGE_NEW=
HUBSPOT_STAGE_IN_REVIEW=
HUBSPOT_STAGE_CLOSED=
